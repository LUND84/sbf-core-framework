# Reason: loopback binding makes the technical demo local by default.
HOST=127.0.0.1
PORT=8080
NODE_ENV=development
# Reason: empty values contain no reusable credentials and disable worker access.
WORKER_TOKEN=
DEMO_ACCESS_CODE=
SESSION_SECRET=
PUBLIC_ORIGIN=
# Reason: the sharing snapshot must not collect live payments by default.
MODULE_C_ENABLED=0
MODULE_C_ADMIN_TOKEN=
